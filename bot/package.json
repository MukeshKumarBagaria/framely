{
  "name": "@giftmahal/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "migrate": "node src/db/migrate.ts",
    "seed": "node scripts/seed-designs.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-module-mocks test/**/*.test.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "sharp": "^0.34.4",
    "tesseract.js": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.2",
    "typescript": "^5.9.3"
  }
}
